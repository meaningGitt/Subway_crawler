{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "앉을 지도 PL-RECORD 파일럿 착석 기록",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pseudonymous_id",
    "service_date",
    "line",
    "direction",
    "boarding_station_key",
    "alighting_station_key",
    "recommended_train_time",
    "actual_boarded_train_time",
    "result",
    "recorded_at"
  ],
  "properties": {
    "pseudonymous_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "가명 식별자; 실명·연락처·위치좌표 금지"
    },
    "service_date": {
      "type": "string",
      "format": "date"
    },
    "line": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "type": "string",
      "minLength": 1
    },
    "boarding_station_key": {
      "type": "string",
      "minLength": 1
    },
    "alighting_station_key": {
      "type": "string",
      "minLength": 1
    },
    "recommended_train_time": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-9]):[0-5][0-9](?::[0-5][0-9])?$"
    },
    "actual_boarded_train_time": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[01][0-9]|2[0-9]):[0-5][0-9](?::[0-5][0-9])?$"
    },
    "result": {
      "enum": [
        "바로 앉음",
        "가다가 앉음",
        "끝까지 서서",
        "안 탐"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "boarded_car": {
      "type": "integer",
      "minimum": 1
    },
    "seated_at_station_key": {
      "type": "string",
      "minLength": 1
    },
    "seat_area": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "가다가 앉음"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "seated_at_station_key"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "안 탐"
          }
        }
      },
      "then": {
        "properties": {
          "actual_boarded_train_time": {
            "type": "null"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "boarded_car"
              ]
            },
            {
              "required": [
                "seat_area"
              ]
            }
          ]
        }
      },
      "else": {
        "properties": {
          "actual_boarded_train_time": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$comment": "스키마 제안만 구현, 사용자 기록 수집 기능 미구현. 기록 비중 n/(n+10), 하루 1회 배치는 서비스 정책이며 이 데이터 파이프라인은 실측 기록 없이 확률/신뢰도/보정 결과를 생성하지 않는다. required actual_boarded_train_time은 안 탐일 때 null."
}
